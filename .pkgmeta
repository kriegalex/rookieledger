# BigWigsMods/packager configuration. The addon lives in addon/RookieLedger, not at the repository root.
package-as: RookieLedger

# The packager copies the repository into RookieLedger/, then moves the addon folder up to be the package itself.
move-folders:
  RookieLedger/addon/RookieLedger: RookieLedger

# The libraries of the minimap button. They are not in the repository: the packager fetches them into the zip.
externals:
  addon/RookieLedger/Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  addon/RookieLedger/Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  addon/RookieLedger/Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  addon/RookieLedger/Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Everything that is not the addon. LICENSE and CHANGELOG.md stay in the zip.
ignore:
  - companion
  - media
  - server
  - tests
  - README.md

enable-nolib-creation: no
